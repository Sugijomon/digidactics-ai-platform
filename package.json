{
  "name": "digidactics-ai-platform",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:sai": "corepack pnpm --dir apps/sai dev",
    "build:sai": "corepack pnpm --dir apps/sai build",
    "lint:sai": "corepack pnpm --dir apps/sai lint",
    "test:domain": "corepack pnpm --dir packages/domain test",
    "test:e2e:sai": "corepack pnpm --dir apps/sai test:e2e",
    "test:all": "corepack pnpm test:domain && corepack pnpm lint:sai && corepack pnpm build:sai && corepack pnpm test:e2e:sai"
  }
}
